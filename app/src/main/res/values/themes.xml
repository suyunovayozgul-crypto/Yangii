<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SignalIPTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/amber</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Theme.SignalIPTV.Player" parent="Theme.SignalIPTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>
</resources>
