<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SignalIPTV" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="colorPrimary">@color/amber</item>
        <item name="colorPrimaryDark">@color/bg</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
    </style>

    <style name="Theme.SignalIPTV.Player" parent="Theme.SignalIPTV">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:statusBarColor">@android:color/black</item>
        <item name="android:navigationBarColor">@android:color/black</item>
    </style>

    <!-- EPG va boshqa dialog oynalari uchun — telefonning tizim
         mavzusiga (och/oq fon) qarab qolmasdan, ilovaning o'z qorong'i
         palitrasini ishlatadi. -->
    <style name="SignalDialogTheme" parent="Theme.AppCompat.Dialog.Alert">
        <item name="android:windowBackground">@drawable/dialog_bg</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColor">@color/text</item>
        <item name="colorAccent">@color/amber</item>
        <item name="android:windowTitleStyle">@style/SignalDialogTitle</item>
    </style>

    <style name="SignalDialogTitle" parent="android:TextAppearance.Medium">
        <item name="android:textColor">@color/text</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
