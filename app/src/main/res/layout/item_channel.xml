<?xml version="1.0" encoding="utf-8"?>
<!-- QAYTA DIZAYN: avvalgi qator tekis to'rtburchak, alohida raqam ustuni va
     hech qanday chuqurlik hissi yo'q edi. Endi har bir kanal — yumaloq
     burchakli, nozik chegarali "shisha" kartochka; raqam logotip ustiga
     kichik doira "badge" sifatida joylashadi, va "hozir" yozuvi ostida
     dasturning necha foizi o'tganini ko'rsatuvchi ingichka progress chiziq
     bor (EPG ishlayotganini ko'zga ko'rinarli qilib ko'rsatish uchun). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/glass_card_row">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="10dp"
        android:paddingEnd="14dp"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <FrameLayout
            android:layout_width="44dp"
            android:layout_height="44dp">

            <ImageView
                android:id="@+id/chLogo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@color/panel2"
                android:scaleType="fitCenter"
                android:padding="5dp" />

            <TextView
                android:id="@+id/chIdx"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|start"
                android:layout_margin="-4dp"
                android:background="@drawable/icon_badge_bg"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:paddingTop="1dp"
                android:paddingBottom="1dp"
                android:text="1"
                android:textColor="@color/amber"
                android:textSize="9sp"
                android:fontFamily="monospace"
                android:textStyle="bold" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="12dp"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/chName"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <View
                    android:id="@+id/chSelectedDot"
                    android:layout_width="7dp"
                    android:layout_height="7dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/dot_live"
                    android:visibility="gone" />
            </LinearLayout>

            <TextView
                android:id="@+id/chGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/muted"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/chProgram"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cyan"
                android:textSize="10sp"
                android:maxLines="1"
                android:ellipsize="end"
                android:layout_marginTop="4dp"
                android:visibility="gone" />

            <FrameLayout
                android:id="@+id/chProgressTrack"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_marginTop="4dp"
                android:background="@color/progress_track"
                android:visibility="gone">

                <View
                    android:id="@+id/chProgressFill"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_gravity="start"
                    android:background="@color/amber" />
            </FrameLayout>

        </LinearLayout>

    </LinearLayout>
</FrameLayout>
