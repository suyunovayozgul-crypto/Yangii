<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="4dp"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="12dp"
    android:paddingEnd="14dp"
    android:paddingTop="10dp"
    android:paddingBottom="10dp"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/bg_channel_item">

    <TextView
        android:id="@+id/chIdx"
        android:layout_width="30dp"
        android:layout_height="wrap_content"
        android:text="001"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:fontFamily="monospace"
        android:gravity="start" />

    <FrameLayout
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:layout_marginStart="10dp">

        <ImageView
            android:id="@+id/chLogo"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_channel_logo"
            android:scaleType="fitCenter"
            android:padding="5dp" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="12dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/chName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end" />

        <TextView
            android:id="@+id/chGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/muted"
            android:textSize="10sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/chProgram"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cyan"
            android:textSize="10sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:layout_marginTop="3dp"
            android:visibility="gone" />
    </LinearLayout>

    <View
        android:id="@+id/chSelectedDot"
        android:layout_width="8dp"
        android:layout_height="8dp"
        android:layout_marginStart="6dp"
        android:background="@drawable/dot_live"
        android:visibility="gone" />

</LinearLayout>
