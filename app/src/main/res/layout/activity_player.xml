<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerDrawerLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- use_controller=false: Media3'ning standart (VOD uchun mo'ljallangan
             seek-bar / 5s-15s tez orqaga-oldinga) boshqaruvi butunlay o'chirilgan.
             Jonli TV kanal uchun bularning hech biri kerak emas va aynan shular
             "sekund sanab" ko'rinishga sabab bo'lgan. O'rniga pastda o'zimizning
             overlay boshqaruvimiz bor. -->
        <androidx.media3.ui.PlayerView
            android:id="@+id/playerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            app:use_controller="false"
            app:show_buffering="always"
            app:resize_mode="fit" />

        <!-- Bosilganda 4 soniyadan keyin o'zi yashirinadigan overlay guruhi -->
        <FrameLayout
            android:id="@+id/overlayGroup"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/playerTopBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/gradient_top_bar"
                android:paddingStart="4dp"
                android:paddingEnd="8dp"
                android:paddingTop="10dp"
                android:paddingBottom="20dp">

                <ImageButton
                    android:id="@+id/playerBackBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_back"
                    android:contentDescription="@string/player_back_button" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/playerTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/amber"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:maxLines="1"
                        android:ellipsize="end" />

                    <TextView
                        android:id="@+id/playerProgram"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/cyan"
                        android:textSize="12sp"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:visibility="gone" />
                </LinearLayout>

                <ImageButton
                    android:id="@+id/playerRotateBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_rotate"
                    android:contentDescription="@string/player_rotate_button" />

                <ImageButton
                    android:id="@+id/playerResizeBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_resize"
                    android:contentDescription="@string/player_resize_button" />

                <ImageButton
                    android:id="@+id/playerChannelsBtn"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="4dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_channels"
                    android:contentDescription="@string/player_channels_button" />
            </LinearLayout>

            <!-- O'ng tomonda tik joylashgan kanal ▲▼ va play/pause —
                 barmoq bilan bosish uchun ham, pult D-pad fokusi uchun ham ishlaydi -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical|end"
                android:layout_marginEnd="18dp"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <ImageButton
                    android:id="@+id/playerChannelUpBtn"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_chevron_up"
                    android:contentDescription="@string/player_channel_up_button" />

                <ImageButton
                    android:id="@+id/playerPlayPauseBtn"
                    android:layout_width="60dp"
                    android:layout_height="60dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="14dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_pause"
                    android:contentDescription="@string/player_pause_button" />

                <ImageButton
                    android:id="@+id/playerChannelDownBtn"
                    android:layout_width="52dp"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_control_circle_focus"
                    android:src="@drawable/ic_chevron_down"
                    android:contentDescription="@string/player_channel_down_button" />
            </LinearLayout>

        </FrameLayout>

        <TextView
            android:id="@+id/playerResizeLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:background="@color/overlay_bar"
            android:paddingStart="18dp"
            android:paddingEnd="18dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:textColor="@color/amber"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

    </FrameLayout>

    <LinearLayout
        android:layout_width="330dp"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:orientation="vertical"
        android:background="@color/drawer_bg">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:text="@string/menu_channels_title"
            android:textColor="@color/text"
            android:textSize="16sp"
            android:textStyle="bold"
            android:background="@color/panel" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:background="@color/panel">

            <LinearLayout
                android:id="@+id/playerTabsRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <EditText
            android:id="@+id/playerSearchBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="10dp"
            android:padding="8dp"
            android:hint="@string/search_hint"
            android:textColorHint="@color/muted"
            android:textColor="@color/text"
            android:textSize="12sp"
            android:background="@color/panel2"
            android:inputType="text"
            android:singleLine="true" />

        <TextView
            android:id="@+id/playerStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="16dp"
            android:textColor="@color/muted"
            android:textSize="12sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/playerChannelList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>

</androidx.drawerlayout.widget.DrawerLayout>
