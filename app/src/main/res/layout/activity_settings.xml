<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@color/panel"
        android:paddingStart="4dp"
        android:paddingEnd="16dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <ImageButton
            android:id="@+id/settingsBackBtn"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_back"
            android:contentDescription="@string/settings_back" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="@string/settings_title"
            android:textColor="@color/text"
            android:textSize="17sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="20dp"
        android:paddingBottom="8dp"
        android:text="@string/settings_language_title"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/settingsLangUz"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="6dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/glass_card_row"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/settings_language_uz"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/settingsLangRu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginTop="10dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:paddingTop="16dp"
        android:paddingBottom="16dp"
        android:background="@drawable/glass_card_row"
        android:clickable="true"
        android:focusable="true"
        android:text="@string/settings_language_ru"
        android:textColor="@color/text"
        android:textSize="15sp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="6dp"
        android:text="@string/settings_epg_title"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:letterSpacing="0.08" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="10dp"
        android:text="@string/settings_epg_hint"
        android:textColor="@color/muted"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:orientation="vertical"
        android:padding="14dp"
        android:background="@drawable/glass_card_row">

        <EditText
            android:id="@+id/settingsEpgUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/panel2"
            android:padding="10dp"
            android:hint="@string/settings_epg_url_hint"
            android:textColorHint="@color/muted"
            android:textColor="@color/text"
            android:textSize="13sp"
            android:inputType="textUri"
            android:singleLine="true" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal">

            <Button
                android:id="@+id/settingsEpgSave"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/tab_chip_selected"
                android:stateListAnimator="@null"
                android:text="@string/settings_epg_save"
                android:textAllCaps="false"
                android:textColor="@color/bg"
                android:textSize="13sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/settingsEpgReset"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@drawable/tab_chip_unselected"
                android:stateListAnimator="@null"
                android:text="@string/settings_epg_reset"
                android:textAllCaps="false"
                android:textColor="@color/text"
                android:textSize="13sp" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="28dp"
        android:paddingBottom="6dp"
        android:text="@string/settings_other_title"
        android:textColor="@color/muted"
        android:textSize="12sp"
        android:letterSpacing="0.08" />

    <TextView
        android:id="@+id/settingsTelegramRow"
        style="@style/DrawerRow"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:background="@drawable/glass_card_row"
        android:drawableStart="@drawable/ic_telegram"
        android:text="@string/menu_telegram" />

</LinearLayout>
