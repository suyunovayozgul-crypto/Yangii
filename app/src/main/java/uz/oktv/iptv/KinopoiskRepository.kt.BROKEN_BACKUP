package uz.oktv.iptv

import org.json.JSONObject
import java.net.HttpURLConnection
import java.net.URL
import java.net.URLEncoder
import java.util.Locale
import android.util.Log

fun fetchKinopoiskData(targetTitle: String, apiKey: String): KinopoiskData {
    if (targetTitle.isNullOrEmpty()) return KinopoiskData()
    try {
        val yearMatcher = Regex("\\b(19\\d{2}|20\\d{2})\\b").find(targetTitle)
        val extractedYear = yearMatcher?.value

        var cleanTitle = targetTitle.lowercase(Locale.getDefault())
        cleanTitle = cleanTitle.replace(Regex("\\([^)]*\\)|\\[[^]]*\\]"), " ")
        cleanTitle = cleanTitle.replace(Regex("(?i)(т/с|х/ф|д/ф|д/с|с/ф|м/ф|м/с|т/ш|д-с|т\\.с|х\\.ф|д\\.ф|д\\.с|с\\.ф|м\\.ф|м\\.с|т\\.ш|с/р|сериал|фильм|мультфильм|художественный|документальный|наше кино|премьера|hdrip|bdrip|web-dl|webdl|1080p|720p|4k|uhd|режиссерская версия)[.:\\s]*"), " ")
        cleanTitle = cleanTitle.replace(Regex("(?i)\\b(\\d+\\s*(с\\.|серия|серии|сезон|сез|выпуск|вып)|(с\\.|серия|сезон)\\s*\\d+)\\b"), " ")
        cleanTitle = cleanTitle.replace(Regex("(?i)\\b\\d+([–-]\\d+)?\\s*с\\b"), " ")
        cleanTitle = cleanTitle.replace(Regex("(?<=[а-яёa-z])(?=[А-ЯЁA-Z])"), " ")
        cleanTitle = cleanTitle.replace(Regex("[^\\p{L}\\p{N}\\s]"), " ")
        cleanTitle = cleanTitle.replace(Regex("\\s+"), " ").trim()

        Log.d("KP_DEBUG", "Входной запрос: '$targetTitle' -> Очищенный: '$cleanTitle'")

        // Точные названия известных телешоу
        cleanTitle = when {
            cleanTitle.contains("уральские пельмени") ->
                "уральские пельмени"

            cleanTitle.contains("однажды в россии") ->
                "однажды в россии"

            else -> cleanTitle
        }

        Log.d("KP_DEBUG", "Каноническое название для Kinopoisk: '$cleanTitle'")

        if (cleanTitle.length < 2) return KinopoiskData()

        fun searchFilm(query: String, year: String?): JSONObject? {
            try {
                val encoded = URLEncoder.encode(query, "UTF-8")
                val yearParam = if (!year.isNullOrEmpty()) "&year=$year" else ""

                // Основной поиск Kinopoisk.
                // Для телешоу год специально не передаём.
                val url22 = URL(
                    "https://kinopoiskapiunofficial.tech/api/v2.2/films?keyword=$encoded$yearParam"
                )

                val conn22 = url22.openConnection() as HttpURLConnection
                conn22.setRequestProperty("X-API-KEY", apiKey)
                conn22.setRequestProperty("Content-Type", "application/json")
                conn22.connectTimeout = 5000
                conn22.readTimeout = 5000

                if (conn22.responseCode == 200) {
                    val resp22 = conn22.inputStream.bufferedReader().use { it.readText() }
                    val json22 = JSONObject(resp22)
                    val items22 = json22.optJSONArray("items")

                    if (items22 != null && items22.length() > 0) {

                        fun normalizeSearchTitle(value: String): String {
                            var normalized = value.lowercase(Locale.getDefault())

                            normalized = normalized
                                .replace("ё", "е")
                                .replace("Ё", "Е")

                            normalized = normalized.replace(
                                Regex("""\([^)]*\)|\[[^]]*\]"""),
                                " "
                            )

                            normalized = normalized.replace(
                                Regex(
                                    """(?i)\b(сериал|фильм|мультфильм|телесериал|телешоу|шоу|сезон|сез|серия|серии|выпуск)\b"""
                                ),
                                " "
                            )

                            normalized = normalized.replace(
                                Regex("""\b(19\d{2}|20\d{2})(\s*[-–]\s*(19\d{2}|20\d{2}|\.\.\.))?\b"""),
                                " "
                            )

                            normalized = normalized.replace(
                                Regex("""[^\p{L}\p{N}\s]"""),
                                " "
                            )

                            return normalized
                                .replace(Regex("""\s+"""), " ")
                                .trim()
                        }

                        val normalizedQuery = normalizeSearchTitle(query)

                        // 1. Сначала ищем абсолютно точное название.
                        for (i in 0 until items22.length()) {
                            val item = items22.getJSONObject(i)

                            val nameRu = normalizeSearchTitle(
                                item.optString("nameRu", "")
                            )

                            val nameOriginal = normalizeSearchTitle(
                                item.optString("nameOriginal", "")
                            )

                            val nameEn = normalizeSearchTitle(
                                item.optString("nameEn", "")
                            )

                            val isExact =
                                normalizedQuery.isNotEmpty() &&
                                (
                                    nameRu == normalizedQuery ||
                                    nameOriginal == normalizedQuery ||
                                    nameEn == normalizedQuery
                                )

                            if (isExact) {
                                Log.d(
                                    "KP_DEBUG",
                                    "ТОЧНОЕ НАЗВАНИЕ: '$normalizedQuery' -> " +
                                            "'${item.optString("nameRu", "")}' " +
                                            "id=${item.optInt("kinopoiskId", 0)}"
                                )

                                return item
                            }
                        }

                        // 2. Для известных шоу допускаем совпадение начала названия.
                        // Например:
                        // "Однажды в России" -> "Однажды в России (2014)"
                        // "Уральские пельмени" -> "Уральские пельмени (2009)"
                        val isShowQuery =
                            normalizedQuery.contains("уральские пельмени") ||
                            normalizedQuery.contains("однажды в россии") ||
                            normalizedQuery.contains("молодежь") ||
                            normalizedQuery.contains("молодёжь")

                        if (isShowQuery) {
                            for (i in 0 until items22.length()) {
                                val item = items22.getJSONObject(i)

                                val nameRu = normalizeSearchTitle(
                                    item.optString("nameRu", "")
                                )

                                val nameOriginal = normalizeSearchTitle(
                                    item.optString("nameOriginal", "")
                                )

                                if (
                                    nameRu.startsWith(normalizedQuery) ||
                                    normalizedQuery.startsWith(nameRu) ||
                                    nameOriginal.startsWith(normalizedQuery) ||
                                    normalizedQuery.startsWith(nameOriginal)
                                ) {
                                    Log.d(
                                        "KP_DEBUG",
                                        "ШОУ ПО СОВПАДЕНИЮ: '$normalizedQuery' -> " +
                                                "'${item.optString("nameRu", "")}' " +
                                                "id=${item.optInt("kinopoiskId", 0)}"
                                    )

                                    return item
                                }
                            }
                        }

                        Log.d(
                            "KP_DEBUG",
                            "ТОЧНОГО РЕЗУЛЬТАТА НЕТ: '$normalizedQuery'"
                        )
                    }
                }

                // Старый резервный API.
                val url21 = URL(
                    "https://kinopoiskapiunofficial.tech/api/v2.1/films/search-by-keyword?keyword=$encoded"
                )

                val conn21 = url21.openConnection() as HttpURLConnection
                conn21.setRequestProperty("X-API-KEY", apiKey)
                conn21.setRequestProperty("Content-Type", "application/json")
                conn21.connectTimeout = 5000
                conn21.readTimeout = 5000

                if (conn21.responseCode == 200) {
                    val resp21 = conn21.inputStream.bufferedReader().use { it.readText() }
                    val json21 = JSONObject(resp21)
                    val films21 = json21.optJSONArray("films")

                    if (films21 != null && films21.length() > 0) {
                            for (i in 0 until films21.length()) {
                            val item = films21.getJSONObject(i)

                            fun normalizeFallbackTitle(value: String): String {
                                var normalized = value
                                    .lowercase(Locale.getDefault())
                                    .replace("ё", "е")

                                normalized = normalized.replace(
                                    Regex("""\([^)]*\)|\[[^]]*\]"""),
                                    " "
                                )

                                normalized = normalized.replace(
                                    Regex("""\b(сериал|фильм|мультфильм|телесериал|телешоу|шоу)\b"""),
                                    " "
                                )

                                normalized = normalized.replace(
                                    Regex("""\b(19\d{2}|20\d{2})(\s*[-–]\s*(19\d{2}|20\d{2}|\.\.\.))?\b"""),
                                    " "
                                )

                                normalized = normalized.replace(
                                    Regex("""[^\p{L}\p{N}\s]"""),
                                    " "
                                )

                                return normalized
                                    .replace(Regex("""\s+"""), " ")
                                    .trim()
                            }

                            val nameRu = normalizeFallbackTitle(
                                item.optString("nameRu", "")
                            )
                            val nameEn = normalizeFallbackTitle(
                                item.optString("nameEn", "")
                            )
                            val nameOriginal = normalizeFallbackTitle(
                                item.optString("nameOriginal", "")
                            )

                            if (
                                nameRu == normalizedQuery ||
                                nameEn == normalizedQuery ||
                                nameOriginal == normalizedQuery ||
                                (
                                    isShowQuery &&
                                    (
                                        nameRu.startsWith(normalizedQuery) ||
                                        normalizedQuery.startsWith(nameRu)
                                    )
                                )
                            ) {
                                Log.d(
                                    "KP_DEBUG",
                                    "РЕЗЕРВНЫЙ ПОИСК: '$normalizedQuery' -> " +
                                            "'${item.optString("nameRu", "")}'"
                                )

                                return item
                            }
                        }
                    }
                }
            } catch (e: Exception) {
                Log.e("KP_DEBUG", "Ошибка поиска Kinopoisk", e)
            }

            return null
        }

        val knownShows = setOf(
            "уральские пельмени",
            "однажды в россии"
        )

        val isKnownShow = cleanTitle in knownShows

        Log.d(
            "KP_DEBUG",
            "Тип поиска: ${if (isKnownShow) "ШОУ" else "ФИЛЬМ"} | Название: '$cleanTitle'"
        )

        var foundFilm = searchFilm(
            cleanTitle,
            if (isKnownShow) null else extractedYear
        )

        if (foundFilm == null && !isKnownShow && !extractedYear.isNullOrEmpty()) {
            foundFilm = searchFilm(cleanTitle, null)
        }



        if (foundFilm != null) {
            val foundFilmId = foundFilm.optInt("filmId", 0)
                .takeIf { it > 0 } ?: foundFilm.optInt("id", 0)
                .takeIf { it > 0 } ?: foundFilm.optInt("kinopoiskId", 0)

            val rating = foundFilm.optString("rating", "").ifEmpty {
                foundFilm.optString("ratingKinopoisk", "")
            }.takeIf { it.isNotEmpty() && it != "null" }

            val poster = foundFilm.optString("posterUrlPreview", "").ifEmpty {
                foundFilm.optString("posterUrl", "")
            }.takeIf { it.isNotEmpty() && it != "null" }

            var rawYear = foundFilm.optString("year", "").ifEmpty {
                foundFilm.optString("startYear", "")
            }.takeIf { it.isNotEmpty() && it != "null" }

            if (!rawYear.isNullOrEmpty() && targetTitle.contains(rawYear)) {
                rawYear = null
            }

            var description = foundFilm.optString("description", "").ifEmpty {
                foundFilm.optString("shortDescription", "")
            }.takeIf { it.isNotEmpty() && it != "null" }

            val genresArray = foundFilm.optJSONArray("genres")
            val genreList = mutableListOf<String>()
            if (genresArray != null) {
                for (i in 0 until genresArray.length()) {
                    val gObj = genresArray.optJSONObject(i)
                    val gName = gObj?.optString("genre") ?: gObj?.optString("name")
                    if (!gName.isNullOrEmpty()) {
                        genreList.add(gName.replaceFirstChar { if (it.isLowerCase()) it.titlecase(Locale.getDefault()) else it.toString() })
                    }
                }
            }

            if (foundFilmId > 0) {
                try {
                    val detailUrl = URL(
                        "https://kinopoiskapiunofficial.tech/api/v2.2/films/$foundFilmId"
                    )
                    val detailConn = detailUrl.openConnection() as HttpURLConnection
                    detailConn.setRequestProperty("X-API-KEY", apiKey)
                    detailConn.setRequestProperty("Content-Type", "application/json")
                    detailConn.connectTimeout = 4000
                    detailConn.readTimeout = 4000

                    if (detailConn.responseCode == 200) {
                        val detailResp = detailConn.inputStream.bufferedReader().use { it.readText() }
                        val detailJson = JSONObject(detailResp)

                        val detailDesc = detailJson.optString("description", "").ifEmpty {
                            detailJson.optString("shortDescription", "")
                        }.takeIf { it.isNotEmpty() && it != "null" }
                        if (!detailDesc.isNullOrEmpty()) {
                            description = detailDesc
                        }

                        val detailRating = detailJson.optString("ratingKinopoisk", "").ifEmpty {
                            detailJson.optString("rating", "")
                        }.takeIf { it.isNotEmpty() && it != "null" }
                        val finalRating = detailRating ?: rating

                        val detailYear = detailJson.optString("year", "").takeIf { it.isNotEmpty() && it != "null" }
                        val finalYear = detailYear ?: extractedYear ?: rawYear

                        val detailGenres = detailJson.optJSONArray("genres")
                        if (detailGenres != null && detailGenres.length() > 0) {
                            genreList.clear()
                            for (i in 0 until detailGenres.length()) {
                                val gObj = detailGenres.optJSONObject(i)
                                val gName = gObj?.optString("genre") ?: gObj?.optString("name")
                                if (!gName.isNullOrEmpty()) {
                                    genreList.add(gName.replaceFirstChar { if (it.isLowerCase()) it.titlecase(Locale.getDefault()) else it.toString() })
                                }
                            }
                        }

                        val detailPoster = detailJson.optString("posterUrl", "").ifEmpty {
                            detailJson.optString("posterUrlPreview", "")
                        }.takeIf { it.isNotEmpty() && it != "null" }
                        val finalPoster = detailPoster ?: poster

                        return KinopoiskData(
                            rating = finalRating,
                            posterUrl = finalPoster,
                            year = finalYear,
                            description = description,
                            genres = genreList.take(2).joinToString(", ")
                        )
                    }
                } catch (_: Exception) {}
            }

            return KinopoiskData(
                rating = rating,
                posterUrl = poster,
                year = extractedYear ?: rawYear,
                description = description,
                genres = genreList.take(2).joinToString(", ")
            )
        }
    } catch (e: Exception) {
        e.printStackTrace()
    }
    return KinopoiskData()
}
